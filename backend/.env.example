LOCAL_LOOKUP_MS=2500
PORT=3100
API_AUTH_TOKEN=replace-with-a-random-secret-at-least-12-characters
CORS_ORIGIN=https://warden-eight-theta.vercel.app
BACKEND_BASE_URL=http://127.0.0.1:3100
SUPABASE_URL=https://example.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-me
LIVEKIT_URL=wss://example.livekit.cloud
LIVEKIT_API_KEY=replace-me

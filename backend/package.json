{
  "name": "warden-telephone-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "agent": "tsx src/agent-entry.ts dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fastify/cors": "^10.1.0",
    "@livekit/agents": "^1.0.0",
    "@livekit/rtc-node": "^0.13.34",
    "@supabase/supabase-js": "^2.57.0",
    "dotenv": "^17.2.2",
    "fastify": "^5.6.0",
    "livekit-server-sdk": "^2.18.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/node": "^24.3.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
